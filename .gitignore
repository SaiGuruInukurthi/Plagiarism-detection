*.parquet.gz

# Model files (too large for git)
models/*.bin
models/*.safetensors
models/*.onnx
models/checkpoints/
models/trained/
*.model
*.ckpt

# Logs and monitoring
logs/*.log
logs/tensorboard/
logs/wandb/
.wandb/

# Results and outputs (keep summary files only)
results/plots/
results/predictions/
results/evaluation/
results/temp/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Large backup files (keep manifest only)
data/backups/backup_*/
!data/backups/backup_*/backup_manifest.json

# spaCy models
en_core_web_*/

# Hugging Face cache
.cache/huggingface/

# Specific to this project
# Large processed datasets (keep samples only)
data/processed/plagiarism_*.txt
data/working/*.pkl
data/working/*.csv
!data/working/*_sample*

# Generated result files
results/*.png
results/*.jpg
results/*.pdf
results/*.html
!results/README.md

# Configuration with sensitive data
config_local.py
.secrets